<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.1.0</Version>
    <AssemblyVersion>1.1.0</AssemblyVersion>
    <FileVersion>1.1.0</FileVersion>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Product>RADIOTEDU Stream Audio Server — Setup Wizard</Product>
    <Company>RadioTEDU</Company>
  </PropertyGroup>

  <ItemGroup Condition="Exists('..\single-publish\main\IcecastStreamMonitor.exe')">
    <EmbeddedResource Include="..\single-publish\main\IcecastStreamMonitor.exe" Link="Payload\IcecastStreamMonitor.exe" />
    <EmbeddedResource Include="..\single-publish\remote\IcecastStreamMonitor.RemoteControl.exe" Link="Payload\IcecastStreamMonitor.RemoteControl.exe" />
  </ItemGroup>

</Project>